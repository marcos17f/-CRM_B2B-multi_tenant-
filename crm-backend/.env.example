# Postgres — usado tanto pela app (via app user) quanto pelo Prisma Migrate (via superuser local em dev)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Segredo do JWT de sessão. Gere um valor forte em produção (ex.: openssl rand -hex 32)
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

PORT=3000
NODE_ENV=development

# WhatsApp Business Platform (Meta Cloud API) — ver src/whatsapp/. Platform-level: um App
# da Meta atende o webhook de todos os workspaces (cada um conecta seu próprio número em
# POST /integrations/whatsapp, que fica na tabela integration_connections).
# App secret do App da Meta — valida a assinatura X-Hub-Signature-256 do webhook.
WHATSAPP_APP_SECRET=""
# Verify token definido por você ao configurar a URL do webhook no painel da Meta
# (Meta chama GET /webhooks/whatsapp?hub.verify_token=... uma vez, na hora de configurar).
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dev-only-change-me"
WHATSAPP_GRAPH_API_VERSION="v20.0"
