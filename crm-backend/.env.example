# Postgres — usado tanto pela app (via app user) quanto pelo Prisma Migrate (via superuser local em dev)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# Segredo do JWT de sessão. Gere um valor forte em produção (ex.: openssl rand -hex 32)
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

PORT=3000
NODE_ENV=development
